# Postgres connection string (Neon, Supabase or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/guardrails

# Claude: set ONE of these two keys.
# Direct Anthropic API key:
ANTHROPIC_API_KEY=
# Or an OpenRouter key (uses OpenRouter's Anthropic-compatible endpoint):
OPENROUTER_API_KEY=

# Optional model id. Defaults: claude-haiku-5-5 (Anthropic) or anthropic/claude-haiku-4.5 (OpenRouter).
# For OpenRouter, copy the exact id from openrouter.ai/models.
LLM_MODEL=
